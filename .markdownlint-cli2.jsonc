{
  // On-demand only: `pnpm lint:md`. Not a CI gate. Most of this project's markdown lives
  // in docs/, which is gitignored, so a CI gate would police only the service READMEs.
  // It earns its place when editing docs/, which is what it is here for.
  "config": {
    // Prose wraps at 100 in this project, matching prettier's printWidth for code.
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false },
    // Duplicate headings are fine across the sibling sections these docs use.
    "MD024": { "siblings_only": true },
    // Bare URLs appear inside citation tables.
    "MD034": false,
    // The docs use bold-as-label in places where a heading would over-structure.
    "MD036": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".next/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    // Generated by graphify, gitignored.
    "graphify-out/**",
    // Vendored from supabase/agent-skills, pinned by computedHash in skills-lock.json.
    ".claude/**",
    ".agents/**",
    // Prose, deliberately formatted.
    "CLAUDE.md",
    "AGENTS.md",
  ],
}
