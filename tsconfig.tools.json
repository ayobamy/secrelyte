// Test and tool code that tsconfig.json leaves out of the Next build's own type-check: the
// Playwright specs and helpers, the scripts and their tests, and the runner configs.
// `pnpm typecheck` checks both projects.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
